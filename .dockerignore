node_modules
build
.git

# Local/dev env files must never leak into a build -- Dockerfile's ARG/ENV
# (or docker-compose build.args) is the only intended way to set
# VITE_SERVICE_API/VITE_GAME_SERVICE_API for an image. A stray local .env with
# local-only base URL would otherwise get COPYed in and silently ship a build
# that talks to a developer's machine (plain `vite build` loads the base .env).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
