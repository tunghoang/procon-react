# Team manager (Express). Served under /manager by nginx (and by the vite dev
# proxy), and its data routes live under /api -- so the base URL keeps that
# prefix (page code appends e.g. /team, /match directly).
VITE_SERVICE_API = /manager/api
# HEXUDON game service (FastAPI), including the /api prefix.
VITE_GAME_SERVICE_API = /api

# Verbose client-side logging (src/utils/debug.js reads it; anything other than
# the exact string "true" is off). Build-time like every VITE_* var, so it has
# to be set before `vite build` -- pass it as a Docker build-arg for an image.
# VITE_DEBUG=true
